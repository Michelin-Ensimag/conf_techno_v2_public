# Identity, copied from the admin-panel registration page (http://localhost:8000/register).
# PEM keys may be written on one line, with "\n" for the line breaks.
TEAM_USERNAME=my-team
TEAM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
TEAM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Public key of the admin, used to verify every message received (shown on the registration page).
ADMIN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ADMIN_USERNAME=admin

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=client-student
GAME_COMMANDS_TOPIC=game.commands
GAME_FACTS_TOPIC=game.facts

LOG_LEVEL=info
MAX_TRUCKS=3
